{
  "name": "nexus-omega-x",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS OMEGA X — Autonomous Intelligence Universe Monorepo",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --parallel run dev",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-digital-twin-e2e.mjs",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "seed": "pnpm --filter @nexus/api seed",
    "agency:orchestrate": "node scripts/agency-orchestrator.mjs",
    "agency:install": "powershell -ExecutionPolicy Bypass -File scripts/install-agency-agents.ps1",
    "munder:sync": "node integrations/munder-difflin/sync-hive.mjs",
    "munder:launch": "node integrations/munder-difflin/launcher.mjs",
    "munder:status": "node integrations/munder-difflin/launcher.mjs --status",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

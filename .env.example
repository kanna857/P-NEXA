# ==============================================================================
# NEXUS OMEGA X — Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - All values in this template are SYNTHETIC STUBS intended ONLY for local development.
# - NEVER commit production secrets, production keys, or live passwords to git.
# - In production/staging, inject secrets via AWS Secrets Manager, HashiCorp Vault,
#   GCP Secret Manager, or Azure Key Vault.
# - Production boots will FAIL FAST if default development keys/credentials are detected.
# ==============================================================================

NODE_ENV=development
PORT=4000
WEB_PORT=5173

# --- Multi-Tenant & Security (ROTATE IN PRODUCTION) ---
# In production: must be a 64+ character cryptographically random high-entropy key
JWT_SECRET=nexus_omega_x_super_secret_jwt_key_2026_at_least_32_chars!
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Seed Credentials (DEVELOPMENT-ONLY / ROTATED) ---
# These seed credentials are strictly prohibited in NODE_ENV=production.
# If seeding is executed in production, these variables MUST be explicitly provided
# with complex credentials, or the seed process will immediately terminate.
SEED_ADMIN_PASSWORD=DevOnly_SuperAdmin_#2026$Rotated!
SEED_DEFAULT_USER_PASSWORD=DevOnly_User_#2026$Rotated!

# --- Database & In-Memory Storage ---
MONGODB_URI=mongodb://localhost:27017/nexus_omega_x
REDIS_URI=redis://localhost:6379

# --- Simulation & Multi-Agent AI Engine ---
DEFAULT_SIMULATION_TICK_RATE_MS=250
MAX_PARALLEL_SCENARIOS=16
DETERMINISTIC_SEED_FALLBACK=424242

# --- OpenTelemetry & Observability ---
OTEL_SERVICE_NAME=nexus-omega-x-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# NEXUS OMEGA X — Environment Configuration

NODE_ENV=development
PORT=4000
WEB_PORT=5173

# Multi-Tenant & Security
JWT_SECRET=nexus_omega_x_super_secret_jwt_key_2026_at_least_32_chars!
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Storage
MONGODB_URI=mongodb://localhost:27017/nexus_omega_x
REDIS_URI=redis://localhost:6379

# Simulation & AI Engine
DEFAULT_SIMULATION_TICK_RATE_MS=250
MAX_PARALLEL_SCENARIOS=16
DETERMINISTIC_SEED_FALLBACK=424242

# OpenTelemetry / Observability
OTEL_SERVICE_NAME=nexus-omega-x-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

